{
  "manifest_version": 3,
  "name": "Form Manege",
  "version": "1.0.0",
  "description": "Cross-domain cookie/storage copy, data-driven navigation, and form auto-fill",
  "permissions": [
    "storage",
    "cookies",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Form Manege"
  },
  "options_ui": {
    "page": "src/config/index.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/content-script.ts-BQ3byQn0.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "assets/content-script.ts-BQ3byQn0.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
