{
  "name": "form-bridge",
  "version": "1.0.0",
  "description": "Browser extension for cross-domain cookie/storage copy and form auto-fill",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "check": "npm run typecheck && npm run typecheck:tests && npm test && npm run build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:skill": "node skills/extract-login-form/scripts/analyze-login-form.test.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "chrome-extension",
    "autofill",
    "cookies",
    "local-storage",
    "manifest-v3"
  ],
  "homepage": "https://github.com/cfljue/FormBridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cfljue/FormBridge.git"
  },
  "bugs": {
    "url": "https://github.com/cfljue/FormBridge/issues"
  },
  "license": "ISC",
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.4.0",
    "@types/chrome": "^0.1.42",
    "@vitest/coverage-v8": "^4.1.7",
    "esbuild": "^0.28.0",
    "happy-dom": "^20.9.0",
    "playwright": "^1.62.1",
    "terser": "^5.47.1",
    "typescript": "^6.0.3",
    "vite": "^7.3.3",
    "vitest": "^4.1.7"
  }
}
