{
  "manifest_version": 3,
  "name": "FormBridge",
  "version": "1.0.0",
  "description": "Cross-domain cookie/storage copy, data-driven navigation, and form auto-fill",
  "permissions": [
    "storage",
    "cookies",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "FormBridge"
  },
  "options_ui": {
    "page": "src/config/index.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content-script.ts"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
